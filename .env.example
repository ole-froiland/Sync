# ─────────────────────────────────────────────────────────────
# Sync – Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your_service_role_key

# ── Site URL ──────────────────────────────────────────────────
# Used as the base for OAuth redirect URIs and the MCP resource identifier.
# Production: set this to your real domain.
# Current production: https://sync-co-op.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sync AI ───────────────────────────────────────────────────
# Server-side only. Do not prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini
# Optional signing secret for pending Sync AI actions.
AI_ACTION_SECRET=replace_with_a_long_random_value

# ── GitHub OAuth App (repository connect) ────────────────────
# Separate OAuth App used ONLY for the per-user GitHub repo connection.
# (Supabase login uses its own GitHub OAuth app configured in the Supabase dashboard.)
#
# Create at: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#
# Homepage URL:                  https://sync-co-op.netlify.app
# Authorization callback URL:    https://sync-co-op.netlify.app/api/github/callback
#
# Required scope: repo
GITHUB_CONNECT_CLIENT_ID=Ov23li...
GITHUB_CONNECT_CLIENT_SECRET=your_github_connect_client_secret

# ── GitHub Personal Access Token (optional) ──────────────────
# Used only as a fallback when Supabase is not configured (mock/dev mode).
# Per-user OAuth tokens (stored in github_connections) take priority in production.
# Scopes needed: repo  (or public_repo for public repos only)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...your_personal_access_token

# ── Calendar OAuth Apps ──────────────────────────────────────
# Google Calendar callback URL:
#   http://localhost:3000/api/calendar/google/callback
#   https://your-domain.com/api/calendar/google/callback
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret

# Microsoft Outlook Calendar callback URL:
#   http://localhost:3000/api/calendar/microsoft/callback
#   https://your-domain.com/api/calendar/microsoft/callback
MICROSOFT_CALENDAR_CLIENT_ID=your_microsoft_calendar_client_id
MICROSOFT_CALENDAR_CLIENT_SECRET=your_microsoft_calendar_client_secret
